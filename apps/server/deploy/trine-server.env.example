# trine 服务端配置（EnvironmentFile，装到 /etc/trine/server.env）
# 全部可省略，省略即用 src/config.ts 里的默认值。
#
# 权限建议：chmod 640 /etc/trine/server.env && chown root:trine ...
# 本模板不含真实凭据。复制到仓库外，再填写真实 TRINE_BARK_KEY。
# 填写后的文件必须按上述权限保护，绝不可提交。

# ---- 监听 ----
# 只听回环：公网入口由 Caddy 反代提供 TLS，服务端进程不该直接暴露
TRINE_HOST=127.0.0.1
TRINE_PORT=8787

# ---- 数据库 ----
# 与 systemd unit 的 ReadWritePaths 保持一致
TRINE_DB=/var/lib/trine/trine.sqlite

# ---- 认证 ----
# 挑战串有效期（毫秒），默认 2 分钟：够一次往返，短到不值得重放
TRINE_CHALLENGE_TTL_MS=120000
# token 有效期，默认 24h；过期后客户端重新走挑战-应答
TRINE_TOKEN_TTL_MS=86400000
# 已废弃且不再生效：空库和新增 agent 都必须使用 agent:invite 签发的短期邀请。
# 保留 0 兼容现有配置；置 1 也不会开放注册。无需为新增机器修改配置或重启。
TRINE_OPEN_REGISTRATION=0
# 认证失败限流：限流 key = deviceId + 来源 IP 复合，且只有**签名校验失败**
# 才计数（挑战串过期属正常竞态，不消耗配额）——否则任何知道 deviceId 的人
# 都能靠刷垃圾请求把真设备挡在门外。取挑战端点另有一套独立的宽松计数器。
TRINE_AUTH_FAIL_WINDOW_MS=600000
TRINE_AUTH_FAIL_MAX=20

# 是否信任反代注入的客户端 IP 头（X-Forwarded-For / X-Real-IP）。
# 默认信任——既定部署形态是 Caddy 反代 + 只听回环，直连地址恒为 127.0.0.1
# 毫无区分度。**若把本进程直接暴露到公网，必须改成 0**，否则任何人都能
# 自带一个头伪造来源、绕开按来源的限流。
TRINE_TRUST_PROXY=1

# ---- Web 客户端接入（两项默认全关：不配就是纯 API 中转，行为同以前）----
# 生产的默认形态是**同源托管**：TRINE_WEB_DIST 指向 apps/web 的构建产物，
# 浏览器访问 SPA 与打 API 用同一个源，压根不跨源，也就不需要 CORS。
#
# 允许跨源访问 /auth/* /healthz /devices /blobs 的 origin 清单，逗号分隔。
# 它的用途是**把 SPA 与服务端分开部署**（前端放对象存储/CDN/另一台机）。
# 本机开发不需要它——web 的 vite dev server 会把 /auth /ws /healthz /devices
# 反代到本服务，开发期同样是同源（见 apps/web/README.md）。
#
# **不接受通配 `*`**（写了直接拒绝启动）：放行的端点里有 /auth/*，那是
# 「拿挑战串签名换 token」的入口，必须逐个列出来。
# 每项必须是纯 origin：scheme://host[:port]，不带路径、不带尾斜杠——
# Origin 请求头就长这样，带路径的值永远匹配不上，所以启动时就报错。
# 不发送 Access-Control-Allow-Credentials：认证走 Authorization 里的 bearer
# token，不靠 cookie，因此没有 CSRF 面。
#TRINE_CORS_ORIGINS=https://web.example.com

# Web 构建产物目录（apps/web 的 `bun run build` 输出，即 apps/web/dist）。
# 设置后本进程直接托管这些静态文件，未命中的 GET（且路径不以
# /auth /ws /healthz /devices 开头）回 index.html 交给前端路由（SPA 深链）。
# 静态响应带 Content-Security-Policy 与 X-Content-Type-Options: nosniff；
# CSP 含 'wasm-unsafe-eval'（libsodium 是 WebAssembly，缺了会静默回落 asm.js）
# 与 style-src 'unsafe-inline'（Tailwind/shadcn 运行时注入内联样式），
# 以及 frame-src blob:（文件预览里的 PDF 放在 iframe 里显示）。
# 留空 = 不托管任何静态文件。
#TRINE_WEB_DIST=/var/lib/trine/web

# 附带效果：上面两项**任意一项**非空时，WS 升级（/ws）启用 Origin 检查——
# 带 Origin 头且既不在 CORS 清单、host 也不等于请求 Host 头的，回 403 不升级。
# 无 Origin 头（agent / CLI）一律放行。两项都留空则不检查（行为同以前）。
# 理由：WebSocket 不受同源策略约束，任意网页都能向本服务开连接；而 pairing
# 角色**免认证**，攻击者借一批访客的浏览器就能绕开按 IP 的每源配额。

# ---- 心跳与连接 ----
# 服务端主动 ping 的周期
TRINE_HEARTBEAT_MS=30000
# 空闲多久没有任何入站帧就断开（客户端侧指数退避重连与之配合）
TRINE_IDLE_TIMEOUT_MS=90000

# ---- 留存策略 ----
# relay 帧留存时长 = 断线补发能力的上限，默认 7 天
TRINE_RELAY_TTL_MS=604800000
# 子流 seq 高水位 TTL（默认 90 天；必须 > TRINE_RELAY_TTL_MS）
# TRINE_HWM_TTL_MS=7776000000
# agent 离线排队 TTL（决策点 1），默认 24h
TRINE_PARKED_TTL_MS=86400000
# 单条流最多留存多少帧，防单会话撑爆库。
# **不变量：必须 >= TRINE_PARKED_MAX_PER_MACHINE**，否则排队中的帧会被留存
# 裁剪挤出窗口。不满足时进程直接拒绝启动（config.ts 的 assertConfigInvariants）
TRINE_RELAY_MAX_PER_STREAM=2000
# 单台机器最多排队多少帧，防离线期间无限堆积
TRINE_PARKED_MAX_PER_MACHINE=500
# 过期清理扫描周期
TRINE_SWEEP_MS=300000

# ---- 附件 blob（消息里的图片 / 文件，见 src/blobs.ts）----
# 浏览器把附件加密后上传到这里，relay 只存密文，每个附件一个文件，不进 SQLite。
# 默认目录是数据库旁边的 blobs/（即 /var/lib/trine/blobs，在 ReadWritePaths 之内）；
# 置空则禁用附件（/blobs 端点一律 503）。
#TRINE_BLOB_DIR=/var/lib/trine/blobs
# 单个附件（密文）上限，默认 256MB。Web 设置里的附件上限不能超过它。
# 上传是流式写盘，内存占用不随文件大小增长；反代（Caddy 默认）不要另设更小的请求体上限
TRINE_BLOB_MAX_BYTES=268435456
# 保留时长，默认 7 天；过期后有设备点开，agent 会从本机副本重新上传
TRINE_BLOB_TTL_MS=604800000

# ---- 推送（D6：Bark 直推 + 可插拔渠道适配器）----
# 两项**必须同时配置或同时留空**：只配一半会让推送静默禁用（你以为配好了
# 其实一条都收不到），因此进程启动时直接拒绝这种组合。留空 = 不启用推送。
#
# Bark 服务器根地址：官方 https://api.day.app，或自建 bark-server 的地址。
# 不要带路径和末尾斜杠——服务端自己拼 /push。
#TRINE_BARK_URL=https://api.day.app
# Bark 设备 key（App 首页那串）。**这是凭据**：不会进日志，也不进 URL
#TRINE_BARK_KEY=xxxxxxxxxxxxxxxxxxxxxx
#
# 单次推送 HTTP 超时。别设太大——推送是尽力而为的旁路，宁可丢也不能拖
TRINE_PUSH_TIMEOUT_MS=5000
# 失败重试固定为 2 次（1s / 3s 退避），不可配：再多也救不回一个挂掉的端点
#
# 在线抑制：有任意 client 在线时不推（人正对着屏幕，再响一声只是噪音）。
# 默认开；想「人在线也推」置 0。
# 注意 client 连接不绑机器（一个 client 同时看所有机器），所以判据是
# 「有没有 client 在线」而非「这台机器有没有人在看」
TRINE_PUSH_SUPPRESS_ONLINE=1
#
# 去抖窗口：同一 (machineId, sessionId, 事件类型) 在窗口内只推一次。
# 一次 run 里可能连发十几条权限请求，不去抖就是刷屏。0 = 关闭去抖
TRINE_PUSH_DEDUPE_MS=30000
#
# 机器标识别名：`machineId=别名` 逗号分隔，例如
#   TRINE_PUSH_ALIAS=a1b2c3d4e5f6=mbp,ff00aa11bb22=vps
# 不配则用 machineId 的 8 字符短前缀。别名是**明文写进推送通知**的，
# 设不设由你——这是知情选择，不影响其余的零知识约束。
#
# 格式细则：
# - 条目之间用逗号分隔，所以**别名值本身不能含逗号**（会被截断成两条）
# - 每条按**第一个** `=` 切分，别名值里可以有 `=`
# - key 写错不会报错，只会安静退回短前缀。启动日志会打一行
#   `[push] 已加载 N 条机器别名：<key 列表>`，拿它对照检查拼写
#TRINE_PUSH_ALIAS=
