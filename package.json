{
  "name": "trine",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:agent": "bun run --filter @trine/agent dev",
    "dev:server": "bun run --filter @trine/server dev",
    "dev:web": "bun run --filter @trine/web dev",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "build": "bun run --filter @trine/web build",
    "check": "bun run typecheck && bun test && bun run build",
    "agent:invite": "bun run apps/server/src/invite-cli.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "patchedDependencies": {
    "libsodium-wrappers@0.7.16": "patches/libsodium-wrappers@0.7.16.patch"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/smokecat/trine.git"
  },
  "packageManager": "bun@1.3.11"
}
